{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Nomi window may use",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "http://*/*"
        }
      ]
    }
  ]
}